# Application
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-random-secret
# SaaS registration remains closed until onboarding and launch gates pass.
REGISTRATION_MODE=closed
REGISTRATION_SUBMISSION_MAXIMUM_REQUESTS=5
REGISTRATION_SUBMISSION_WINDOW_MINUTES=60
EMAIL_VERIFICATION_LIFETIME_HOURS=24
VERIFICATION_RESEND_MAXIMUM_REQUESTS=3
VERIFICATION_RESEND_WINDOW_MINUTES=60
PASSWORD_RESET_LIFETIME_MINUTES=30
PASSWORD_RESET_MAXIMUM_REQUESTS=3
PASSWORD_RESET_WINDOW_MINUTES=60

# Versioned Fernet keyring for encrypted provider credentials.
# Generate an initial key with:
# uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode("ascii"))'
# Insert the result as the JSON value for version 1.
PROVIDER_CREDENTIAL_KEYS={"1":"replace-with-a-generated-fernet-key"}
PROVIDER_CREDENTIAL_CURRENT_KEY_VERSION=1

# Transactional-email recipient keyring (ADR 0009). Separate from
# PROVIDER_CREDENTIAL_KEYS; used only to encrypt the unscoped deletion-
# completion recipient until delivery. Leave unset until that slice ships.
# Generate each key like the provider credential keys, then uncomment:
# TRANSACTIONAL_EMAIL_KEYS={"1":"replace-with-a-generated-fernet-key"}
# TRANSACTIONAL_EMAIL_CURRENT_KEY_VERSION=1

# Transactional email delivery (ADR 0009). Disabled by default; when
# enabled, the API key, sender address, and public base URL are required.
# The public base URL is an origin (HTTPS outside development and test)
# used to build verification and reset links; it is separate from
# FRONTEND_ORIGIN. Placeholders only; never commit a real API key.
# TRANSACTIONAL_EMAIL_ENABLED=false
# TRANSACTIONAL_EMAIL_PROVIDER=resend
# TRANSACTIONAL_EMAIL_FROM_ADDRESS=notifications@example.com
# TRANSACTIONAL_EMAIL_FROM_NAME=Fantasy What-If
# TRANSACTIONAL_EMAIL_PUBLIC_BASE_URL=http://localhost:5173
# TRANSACTIONAL_EMAIL_API_KEY=replace-with-provider-api-key
# TRANSACTIONAL_EMAIL_CONNECT_TIMEOUT_SECONDS=3
# TRANSACTIONAL_EMAIL_READ_TIMEOUT_SECONDS=7

# Browser and frontend
FRONTEND_ORIGIN=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173

# Comma-separated IP addresses or CIDR ranges allowed to supply
# forwarded client headers. Never use "*" in production.
#
# Development uses loopback because Vite proxies to the backend.
# Production Compose overrides this with FRONTEND_PROXY_IP.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Production frontend ingress and internal proxy addressing.
# Keep APP_BIND_ADDRESS on loopback when Cloudflare Tunnel,
# Caddy, Traefik, or another host-level proxy provides ingress.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
PRODUCTION_SUBNET=172.31.100.0/24
FRONTEND_PROXY_IP=172.31.100.10

# Authentication
SESSION_COOKIE_NAME=fantasy_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_HOURS=168

# PostgreSQL
POSTGRES_DB=fantasy_what_if
POSTGRES_USER=fantasy_app
POSTGRES_PASSWORD=replace-with-a-private-password
DATABASE_URL=postgresql+psycopg://fantasy_app:replace-with-a-private-password@localhost:5433/fantasy_what_if
DATABASE_ECHO=false

# Scheduled synchronization
# Disabled during development. Enable only in the dedicated
# production sync-scheduler container.
SYNC_SCHEDULER_ENABLED=false
SYNC_SCHEDULE_TIMEZONE=America/Chicago
# Python weekday: Monday=0, Wednesday=2, Sunday=6
SYNC_SCHEDULE_WEEKDAY=2
SYNC_SCHEDULE_HOUR=6
SYNC_SCHEDULE_MINUTE=0
SYNC_SCHEDULER_POLL_SECONDS=30

# PostgreSQL background worker
# Enable only in the dedicated backend-worker process.
BACKGROUND_WORKER_ENABLED=false
BACKGROUND_WORKER_POLL_SECONDS=5
BACKGROUND_WORKER_LEASE_SECONDS=300
# Must remain shorter than BACKGROUND_WORKER_LEASE_SECONDS.
BACKGROUND_WORKER_HEARTBEAT_SECONDS=60
BACKGROUND_WORKER_DATABASE_BACKOFF_SECONDS=10
# Scan for expired running-job leases once per interval.
BACKGROUND_WORKER_RECOVERY_INTERVAL_SECONDS=60
# Delay before an expired retryable job becomes claimable again.
BACKGROUND_WORKER_RECOVERY_RETRY_DELAY_SECONDS=30
# Maximum expired jobs recovered in one committed scan.
BACKGROUND_WORKER_RECOVERY_BATCH_SIZE=100
# Optional stable worker identity. When omitted, hostname:pid is used.
BACKGROUND_WORKER_ID=
