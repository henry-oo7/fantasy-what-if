# Application
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-random-secret

# Dedicated Fernet key for encrypted provider credentials.
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode("ascii"))'
PROVIDER_CREDENTIAL_KEY=

# Browser and frontend
FRONTEND_ORIGIN=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173

# Comma-separated IP addresses or CIDR ranges allowed to supply
# forwarded client headers. Never use "*" in production.
#
# Development uses loopback because Vite proxies to the backend.
# Production Compose overrides this with FRONTEND_PROXY_IP.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Production frontend ingress and internal proxy addressing.
# Keep APP_BIND_ADDRESS on loopback when Cloudflare Tunnel,
# Caddy, Traefik, or another host-level proxy provides ingress.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
PRODUCTION_SUBNET=172.31.100.0/24
FRONTEND_PROXY_IP=172.31.100.10

# Authentication
SESSION_COOKIE_NAME=fantasy_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_HOURS=168

# ESPN
ESPN_S2=
ESPN_SWID=

# PostgreSQL
POSTGRES_DB=fantasy_what_if
POSTGRES_USER=fantasy_app
POSTGRES_PASSWORD=replace-with-a-private-password
DATABASE_URL=postgresql+psycopg://fantasy_app:replace-with-a-private-password@localhost:5433/fantasy_what_if
DATABASE_ECHO=false

# Scheduled synchronization
# Disabled during development. Enable only in the dedicated
# production sync-scheduler container.
SYNC_SCHEDULER_ENABLED=false
SYNC_SCHEDULE_TIMEZONE=America/Chicago
# Python weekday: Monday=0, Wednesday=2, Sunday=6
SYNC_SCHEDULE_WEEKDAY=2
SYNC_SCHEDULE_HOUR=6
SYNC_SCHEDULE_MINUTE=0
SYNC_SCHEDULER_POLL_SECONDS=30
