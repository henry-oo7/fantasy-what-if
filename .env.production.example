# Container release
APP_VERSION=latest

# Public HTTPS address used to open Fantasy What-If.
# This must match the address configured in the reverse proxy
# or Cloudflare Tunnel.
FRONTEND_ORIGIN=https://fantasy.example.com
TRUSTED_ORIGINS=https://fantasy.example.com

# Application security
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=generate-this-value
# Keep production registration closed during development and migration.
REGISTRATION_MODE=closed
REGISTRATION_SUBMISSION_MAXIMUM_REQUESTS=5
REGISTRATION_SUBMISSION_WINDOW_MINUTES=60
EMAIL_VERIFICATION_LIFETIME_HOURS=24
VERIFICATION_RESEND_MAXIMUM_REQUESTS=3
VERIFICATION_RESEND_WINDOW_MINUTES=60
PASSWORD_RESET_LIFETIME_MINUTES=30
PASSWORD_RESET_MAXIMUM_REQUESTS=3
PASSWORD_RESET_WINDOW_MINUTES=60
# JSON keyring generated by scripts/generate-production-env.sh.
PROVIDER_CREDENTIAL_KEYS=generate-this-value
PROVIDER_CREDENTIAL_CURRENT_KEY_VERSION=1

# Transactional-email recipient keyring (ADR 0009). Separate from
# PROVIDER_CREDENTIAL_KEYS. Required in production even while
# TRANSACTIONAL_EMAIL_ENABLED is false: startup fails closed without it.
# JSON keyring generated by scripts/generate-production-env.sh.
TRANSACTIONAL_EMAIL_KEYS=generate-this-value
TRANSACTIONAL_EMAIL_CURRENT_KEY_VERSION=1

# Transactional email delivery (ADR 0009). Disabled by default; when
# enabled, the API key, sender address, and public base URL are required.
# The public base URL is an origin (HTTPS outside development and test)
# used to build verification and reset links; it is separate from
# FRONTEND_ORIGIN. Placeholders only; never commit a real API key.
# TRANSACTIONAL_EMAIL_ENABLED=false
# TRANSACTIONAL_EMAIL_PROVIDER=resend
# TRANSACTIONAL_EMAIL_FROM_ADDRESS=notifications@example.com
# TRANSACTIONAL_EMAIL_FROM_NAME=Fantasy What-If
# TRANSACTIONAL_EMAIL_PUBLIC_BASE_URL=https://fantasy.example.com
# TRANSACTIONAL_EMAIL_API_KEY=replace-with-provider-api-key
# TRANSACTIONAL_EMAIL_CONNECT_TIMEOUT_SECONDS=3
# TRANSACTIONAL_EMAIL_READ_TIMEOUT_SECONDS=7

# Authentication cookies
SESSION_COOKIE_NAME=__Host-fantasy_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_HOURS=168

# PostgreSQL
POSTGRES_DB=fantasy_what_if
POSTGRES_USER=fantasy_app
POSTGRES_PASSWORD=generate-this-value
DATABASE_ECHO=false

# Host ingress and internal trusted proxy
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
PRODUCTION_SUBNET=172.31.100.0/24
FRONTEND_PROXY_IP=172.31.100.10
FORWARDED_ALLOW_IPS=172.31.100.10

# Scheduled synchronization
SYNC_SCHEDULER_ENABLED=false
SYNC_SCHEDULE_TIMEZONE=America/Chicago
# Python weekday: Monday=0, Wednesday=2, Sunday=6
SYNC_SCHEDULE_WEEKDAY=2
SYNC_SCHEDULE_HOUR=6
SYNC_SCHEDULE_MINUTE=0
SYNC_SCHEDULER_POLL_SECONDS=30
