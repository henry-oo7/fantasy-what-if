# Container release
APP_VERSION=latest

# Public HTTPS address used to open Fantasy What-If.
# This must match the address configured in the reverse proxy
# or Cloudflare Tunnel.
FRONTEND_ORIGIN=https://fantasy.example.com
TRUSTED_ORIGINS=https://fantasy.example.com

# Application security
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=generate-this-value
PROVIDER_CREDENTIAL_KEY=generate-this-value

# Authentication cookies
SESSION_COOKIE_NAME=__Host-fantasy_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_LIFETIME_HOURS=168

# PostgreSQL
POSTGRES_DB=fantasy_what_if
POSTGRES_USER=fantasy_app
POSTGRES_PASSWORD=generate-this-value
DATABASE_ECHO=false

# Host ingress and internal trusted proxy
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
PRODUCTION_SUBNET=172.31.100.0/24
FRONTEND_PROXY_IP=172.31.100.10
FORWARDED_ALLOW_IPS=172.31.100.10

# Scheduled synchronization
SYNC_SCHEDULER_ENABLED=false
SYNC_SCHEDULE_TIMEZONE=America/Chicago
# Python weekday: Monday=0, Wednesday=2, Sunday=6
SYNC_SCHEDULE_WEEKDAY=2
SYNC_SCHEDULE_HOUR=6
SYNC_SCHEDULE_MINUTE=0
SYNC_SCHEDULER_POLL_SECONDS=30

# ESPN provider credentials are entered through the setup UI.
ESPN_S2=
ESPN_SWID=
